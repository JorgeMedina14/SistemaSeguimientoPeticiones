NODE_ENV=development
PORT=5000

# Local (Windows + SQLEXPRESS): no ponga DB_USER ni DB_PASSWORD
DB_SERVER=localhost\SQLEXPRESS
DB_DATABASE=MuniPeticionesJalapa
DB_TRUSTED_CONNECTION=true

# Railway / nube: usuario SQL (sa u otro). Si existen, se ignora Windows Auth.
# DB_USER=sa
# DB_PASSWORD=ClaveFuerte123
# DB_SERVER=sqlserver.railway.internal
# DB_PORT=1433
# DB_ENCRYPT=true
# DB_TRUST_SERVER_CERTIFICATE=true

JWT_SECRET=cambie_esta_clave_en_produccion
JWT_EXPIRES_IN=8h
